# secrets
.env
.env.*
!.env.example
*.pem

# circuit build artifacts (large / regenerable / trusted-setup entropy)
# NOTE: verification_key.json is exported to circuits/verification_key.json
# (outside build/) specifically so it is NOT caught by this rule and gets committed.
circuits/build/
*.ptau
*.zkey
*.wtns
# app/public/circuits/ is populated by `npm run sync-circuit` (see
# app/scripts/sync-circuit.mjs) from circuits/build/ — same reasoning.
app/public/circuits/

# rust
target/
Cargo.lock.bak

# node
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# misc
.DS_Store
scratch/

# local tooling config (not project source)
.claude/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
